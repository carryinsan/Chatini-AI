{
  "version": 2,
  "headers": [
    {
      "source": "/(.*)\\.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/image",
      "destination": "/api/image.js"
    },
    {
      "source": "/api/business/:match*",
      "destination": "/api/business"
    },
    {
      "source": "/api/businesspro/:match*",
      "destination": "/api/businesspro"
    }
  ]
}
